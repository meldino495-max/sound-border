{
  "manifest_version": 3,
  "name": "声浪边框",
  "short_name": "声浪边框",
  "version": "1.0.0",
  "description": "标签页一出声，页面四边就出现流动光边；可选监听麦克风，没有输入时边框变红抖动并通知。",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "windows", "storage", "notifications", "offscreen", "scripting", "alarms", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "声浪边框",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
